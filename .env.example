# Copy this file to .env.<stage> (for local dev use .env.dev)
# Example: cp .env.example .env.dev

# For local dev, use the following:
OIDC_CLIENT_ID=<your-client-id>
OIDC_CUSTOM_DOMAIN=https://auth.test.login-connexion.alpha.canada.ca
OIDC_MANAGE_BASE_URL=https://app.test.login-connexion.alpha.canada.ca
OIDC_CLIENT_SECRET=<your-client-secret>

# For staging, use the following:
OIDC_CLIENT_ID=<your-client-id>
OIDC_CUSTOM_DOMAIN=https://auth.login-connexion.alpha.canada.ca
OIDC_MANAGE_BASE_URL=https://app.login-connexion.alpha.canada.ca
OIDC_TOKEN_ENDPOINT=https://auth.login-connexion.alpha.canada.ca/v1.0/endpoint/default/token
AUTH_STATUS_ALLOWED_ORIGINS=https://geo.ca,https://www.geo.ca,https://wordpress.dev.geo.ca
OIDC_CLIENT_SECRET=<your-client-secret>
OIDC_PRIVATE_KEY_SECRET_ID=staging/oidc/private-key
OIDC_USE_PRIVATE_KEY_JWT=true
OIDC_JWT_KID=staging-nrcan-geoca-signer
SESSION_COOKIE_SECRET=replace-with-unique-staging-random-secret

# For production, use the following:
OIDC_CLIENT_ID=<your-client-id>
OIDC_CUSTOM_DOMAIN=https://auth.login-connexion.canada.ca
OIDC_MANAGE_BASE_URL=https://app.login-connexion.canada.ca
OIDC_TOKEN_ENDPOINT=https://auth.login-connexion.canada.ca/v1.0/endpoint/default/token
AUTH_STATUS_ALLOWED_ORIGINS=https://geo.ca,https://www.geo.ca
OIDC_CLIENT_SECRET=<your-client-secret>
OIDC_PRIVATE_KEY_SECRET_ID=production/oidc/private-key
OIDC_USE_PRIVATE_KEY_JWT=true
OIDC_JWT_KID=prod-nrcan-geoca-signer
SESSION_COOKIE_SECRET=replace-with-unique-production-random-secret

# OIDC / Sign-in Configuration
OIDC_CLIENT_ID=<your-client-id>
OIDC_CUSTOM_DOMAIN=https://auth.test.login-connexion.alpha.canada.ca
# CanadaLogin manage app base URL for the selected environment.
# Test: https://app.test.login-connexion.alpha.canada.ca
# Staging: https://app.login-connexion.alpha.canada.ca
# Production: https://app.login-connexion.canada.ca
OIDC_MANAGE_BASE_URL=https://app.test.login-connexion.alpha.canada.ca
OIDC_CLIENT_SECRET=<your-client-secret>
# Required in staging and production. Generate a unique value for each stage,
# for example with: openssl rand -base64 32
# SESSION_COOKIE_SECRET=<unique-random-secret>
# Optional comma-separated exact origins allowed to read /api/auth-status with credentials.
# Production defaults to https://geo.ca and https://www.geo.ca; set the static-site origin for staging.
# AUTH_STATUS_ALLOWED_ORIGINS=https://geo.ca,https://www.geo.ca
# Optional: requested OIDC scopes (space- or comma-delimited).
# Supported values: openid, profile, email, phone, language
# Defaults to openid when omitted.
# OIDC_REQUESTED_SCOPES=openid email language

# Production/staging only: AWS Secrets Manager secret ID for OIDC private key.
# Used for private_key_jwt authentication (replaces client_secret_post).
# Format: <stage>/oidc/private-key
# Leave empty for local development to use client_secret_post instead.
# OIDC_PRIVATE_KEY_SECRET_ID=prod/oidc/private-key
# OIDC_USE_PRIVATE_KEY_JWT=true
# Optional: Key ID for JWT header - required by some providers (e.g., CanadaLogin/IBM Verify) to identify the signing key.
# OIDC_JWT_KID=<your-key-id>
# Optional: Token endpoint URL override when provider uses a non-standard path.
# OIDC_TOKEN_ENDPOINT=https://auth.example.com/v1.0/endpoint/default/token
